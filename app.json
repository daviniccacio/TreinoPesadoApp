{
  "expo": {
    "name": "Treino Pesado Academia",
    "slug": "treino-pesado",
    "scheme": "treinopesado",
    "version": "1.3.1",
    "orientation": "portrait",
    "icon": "./src/assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.daviniccacio.treinopesado",
      "backgroundColor": "#09090b",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "versionCode": 10,
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/logo-treino-pesado-icon.png",
        "backgroundColor": "#1b1b1d"
      },
      "package": "com.daviniccacio.treinopesado",
      "backgroundColor": "#09090b"
    },
    "web": {
      "favicon": "./src/assets/icon.png"
    },
    "extra": {
      "eas": {
        "projectId": "94a45cee-7aa6-42d1-9c27-7faeade308ca"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/94a45cee-7aa6-42d1-9c27-7faeade308ca",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 10000
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      "expo-image",
      "expo-router",
      "expo-status-bar",
      "expo-asset",
      [
        "expo-notifications",
        {
          "icon": "./src/assets/logo-treino-pesado-icon.png",
          "color": "#59C83A"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      "expo-sharing"
    ]
  }
}
