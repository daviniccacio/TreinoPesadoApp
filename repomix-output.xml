                    {category.title}
                  </Text>
                  <View className="flex-row items-center mt-1">
                    <Text className="text-white/90 text-xs font-semibold mr-1">
                      Ver treinos
                    </Text>
                    <CaretRight size={12} color="#ffffff" weight="bold" />
