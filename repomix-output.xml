          {/* GIF Demonstrativo */}
          <View className="w-full h-72 bg-white dark:bg-white rounded-3xl overflow-hidden mb-6 items-center justify-center p-2 border border-[#e2dfe1] dark:border-zinc-800">
            <Image
              source={getExerciseGif(exercise.gif_key)}
