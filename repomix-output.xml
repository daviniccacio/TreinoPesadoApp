import React, { useState, useCallback } from 'react';
import {
  View,
  Text,
  TouchableOpacity,
  FlatList,
  ActivityIndicator,
  useColorScheme,
} from 'react-native';
import { useFocusEffect, useRouter } from 'expo-router';
import { useSafeAreaInsets } from 'react-native-safe-area-context';
import { Plus, Barbell } from 'phosphor-react-native';
import { supabase } from '../../../lib/supabase';

interface Routine {
  id: string;
  title: string;
  description: string;
  created_at: string;
}

export default function PersonalRoutinesScreen() {
  const router = useRouter();
  const insets = useSafeAreaInsets();
  const colorScheme = useColorScheme();
  const isDark = colorScheme === 'dark';

  const [routines, setRoutines] = useState<Routine[]>([]);
  const [loading, setLoading] = useState<boolean>(true);

  useFocusEffect(
    useCallback(() => {
      fetchRoutines();
    }, [])
  );

  async function fetchRoutines() {
    try {
      setLoading(true);
      // Consulta as rotinas criadas pelo personal
      const { data, error } = await supabase
        .from('workouts') // ou a tabela de treinos que usamos no app
        .select('*')
        .order('created_at', { ascending: false });

      if (error) {
        console.error('Erro ao buscar rotinas:', error.message);
      } else if (data) {
        setRoutines(data);
      }
    } catch (err) {
      console.error('Erro inesperado:', err);
    } finally {
      setLoading(false);
    }
  }

  return (
    <View
      className="flex-1 bg-white dark:bg-zinc-950 px-5"
      style={{ paddingTop: insets.top + 10 }}
    >
      {/* Cabeçalho */}
      <View className="flex-row items-center justify-between mb-6 border-b border-[#f0edef] dark:border-zinc-800 pb-4">
        <View>
          <Text className="text-2xl font-extrabold text-[#1b1b1d] dark:text-white">
            Gestão de Treinos
          </Text>
          <Text className="text-sm text-[#71717a] dark:text-zinc-400 mt-1">
            Crie e atribua rotinas aos seus alunos
          </Text>
        </View>

        <TouchableOpacity
          onPress={() => router.push('/(personal)/create-routine')}
          className="w-11 h-11 rounded-full bg-[#59C83A] items-center justify-center shadow-md"
          activeOpacity={0.8}
        >
          <Plus size={22} color="#ffffff" weight="bold" />
        </TouchableOpacity>
      </View>

      {/* Conteúdo */}
      {loading ? (
        <View className="flex-1 justify-center items-center">
          <ActivityIndicator size="large" color="#59C83A" />
        </View>
      ) : routines.length === 0 ? (
        <View className="flex-1 justify-center items-center px-6">
          <Barbell size={48} color="#808591" />
          <Text className="text-[#1b1b1d] dark:text-white font-bold text-base mt-4 text-center">
            Nenhuma rotina criada
          </Text>
          <Text className="text-xs text-[#71717a] dark:text-zinc-400 text-center mt-1">
            Toque no botão '+' no canto superior para criar o primeiro treino.
          </Text>
        </View>
      ) : (
        <FlatList
          data={routines}
          keyExtractor={(item) => item.id}
          showsVerticalScrollIndicator={false}
          renderItem={({ item }) => (
            <View className="bg-[#f8f9fa] dark:bg-zinc-900 p-4 rounded-2xl mb-3 border border-[#e2dfe1] dark:border-zinc-800">
              <Text className="text-base font-bold text-[#1b1b1d] dark:text-white">
                {item.title}
              </Text>
              <Text className="text-xs text-[#71717a] dark:text-zinc-400 mt-1">
                {item.description || 'Sem descrição informada'}
              </Text>
            </View>
          )}
        />
      )}
    </View>
  );
}
